// Cloudflare Worker serving the newsletters site as static assets (no Worker code).
// Deployed by .github/workflows/deploy.yml; dist/ is built by `npm run build`.
{
  "name": "gvwg-newsletter-search",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "newsletters.gvwg.ca", "custom_domain": true },
    // Retired; remove once the CE banner points at newsletters.gvwg.ca.
    { "pattern": "search.gvwg.ca", "custom_domain": true }
  ]
}
